<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.AirtelMoneyPrinter" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/airtel_red</item>
        <item name="colorPrimaryVariant">@color/airtel_red_dark</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/airtel_red_light</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="android:statusBarColor">@color/airtel_red_dark</item>
    </style>

    <style name="CardStyle" parent="Widget.MaterialComponents.CardView">
        <item name="cardElevation">4dp</item>
        <item name="cardCornerRadius">8dp</item>
        <item name="contentPadding">16dp</item>
    </style>

    <style name="ButtonPrimary" parent="Widget.MaterialComponents.Button">
        <item name="backgroundTint">@color/airtel_red</item>
        <item name="android:textColor">@color/white</item>
    </style>
</resources>
